[gd_resource type="Environment" format=3]

; 2D 네온 발광용 공용 Environment. Game.tscn / Menu.tscn 의 WorldEnvironment 가 공유한다.
; background_mode = 3 (BG_CANVAS) — 2D 캔버스 글로우의 필수 조건.
; glow_hdr_threshold = 1.0 이므로 **1.0 을 초과하는 픽셀만** 번진다.
;   → HUD 라벨/버튼(전부 1.0 이하)은 영향을 받지 않는다.
;   → 적·총알까지 번지게 하려면 이 값을 0.8 정도로 내리거나 해당 색을 1.0 초과로 올릴 것.
;      (threshold 를 내리면 HUD 텍스트도 함께 번져 가독성이 떨어진다 — 트레이드오프)
; 모바일 GL 에서 글로우는 fill-rate 비용이 있다. 실기기 프레임 확인 필수.

[resource]
background_mode = 3
glow_enabled = true
glow_levels/2 = 1.0
glow_levels/3 = 1.0
glow_levels/4 = 0.6
glow_levels/5 = 0.3
glow_intensity = 0.9
glow_strength = 1.0
glow_bloom = 0.05
glow_blend_mode = 0
glow_hdr_threshold = 1.0
glow_hdr_scale = 2.0
