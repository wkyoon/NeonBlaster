; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NeonBlaster"
config/description="Neon top-down shooter with AdMob"
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.05, 0.03, 0.11, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/icons/icon_full.png"
config/icon="res://assets/icons/icon.png"
; ⚠️ 안드로이드 뒤로 가기로 **앱이 꺼지지 않게** 한다. SceneManager 가 받아서 메뉴로 돌아간다.
config/quit_on_go_back=false

[autoload]

GameManager="*res://scripts/GameManager.gd"
SceneManager="*res://scripts/SceneManager.gd"
AdsManager="*res://scripts/AdsManager.gd"
PurchaseManager="*res://scripts/PurchaseManager.gd"
ShareManager="*res://scripts/ShareManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
EffectsManager="*res://scripts/EffectsManager.gd"
WordManager="*res://scripts/WordManager.gd"
RewardManager="*res://scripts/RewardManager.gd"
DifficultyDirector="*res://scripts/DifficultyDirector.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
# ⚠️ **expand 가 아니라 keep 이다.** expand 는 폭만 720 으로 고정하고 높이를 기기 비율만큼
# 늘려서, 세로가 긴 기기일수록 플레이 영역이 넓어지고 **난이도가 기기마다 달라졌다**
# (9:16 → 720x1280, 실기기 1:2.14 → 720x1544).
# keep 은 720x1280 비율을 모든 기기에서 그대로 유지하고 남는 부분을 여백으로 둔다.
# 실기기(1080x2316) 기준 위아래 각 198px 여백이 생기고, 그 아래 여백에 배너(150px)가 들어간다.
window/stretch/aspect="keep"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/SharePlugin/plugin.cfg", "res://addons/AdmobPlugin/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="bullet_player"
2d_physics/layer_4="bullet_enemy"
2d_physics/layer_5="pickup"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.09, 1)
