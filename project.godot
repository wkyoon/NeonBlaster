; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NeonBlaster"
config/description="Neon top-down shooter with AdMob"
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icons/icon.png"
; 부트 스플래시. 설정이 없으면 **Godot 기본 로고**가 뜬다(배포판에서도).
; 게임 엠블럼으로 교체하고 배경도 게임 톤(어두운 보라)에 맞춘다.
; 안드로이드는 export_presets 의 splash_screen/disable_godot_boot_splash 도 함께 꺼야 한다.
boot_splash/bg_color=Color(0.05, 0.03, 0.11, 1)
boot_splash/image="res://assets/icons/icon_full.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

GameManager="*res://scripts/GameManager.gd"
SceneManager="*res://scripts/SceneManager.gd"
AdsManager="*res://scripts/AdsManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
EffectsManager="*res://scripts/EffectsManager.gd"
WordManager="*res://scripts/WordManager.gd"
RewardManager="*res://scripts/RewardManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="bullet_player"
2d_physics/layer_4="bullet_enemy"
2d_physics/layer_5="pickup"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.09, 1)
